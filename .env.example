PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development

# VERPLICHT
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true
ADMIN_PASSWORD=use-a-strong-password-of-at-least-12-characters
COOKIE_SECRET=use-a-random-secret-of-at-least-32-characters
CRON_SECRET=use-another-random-secret-of-at-least-32-characters

# BEDRIJF
BUSINESS_NAME=Bedrijfsnaam
BUSINESS_EMAIL=info@example.be
BUSINESS_PHONE=+32...
BUSINESS_WEBSITE=https://example.be
BUSINESS_AREA=Aalst en omgeving
BUSINESS_HOURS=Ma-Vr 08:00-18:00
GOOGLE_REVIEW_URL=https://g.page/r/.../review
BUSINESS_SERVICES=Dienst 1|Dienst 2|Offerte op maat

# ECHTE AI - geen fallback/simulatie
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ECHTE TRANSACTIONELE E-MAIL - geen demo-log
RESEND_API_KEY=
RESEND_FROM=Bedrijfsnaam <noreply@jouwdomein.be>

# ECHTE WHATSAPP CLOUD API - optioneel kanaal naast e-mail
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# AUTOMATISERING
LEAD_FOLLOWUP_HOURS=24
APPOINTMENT_REMINDER_HOURS=24
AUTOMATION_INTERVAL_MINUTES=5
