{
  "name": "ai-business-automation-production",
  "version": "3.0.0",
  "private": true,
  "description": "Production AI business automation for local businesses",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check src/core/routes.js && node --check src/core/flow.js && node --check src/core/automation.js",
    "build": "esbuild ui/app.tsx --bundle --minify --outfile=public/central.js --define:process.env.NODE_ENV=\"\\\"production\\\"\"",
    "test": "node --test test/*.test.js",
    "postinstall": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "openai": "7.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.21.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
